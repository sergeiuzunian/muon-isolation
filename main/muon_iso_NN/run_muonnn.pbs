#!/bin/bash
#PBS -N muon_nn_best
#PBS -l select=1:ncpus=1:mem=64gb
#PBS -l walltime=02:00:00
#PBS -q rqdf
#PBS -o /home/suzunyan/projects/muonisolation/job_logs/
#PBS -e /home/suzunyan/projects/muonisolation/job_logs/
#PBS -m ae

#muonNN.py best configuration: 15x15 at 21 epochs, regenerated with Youden J on the ROC plot

cd "$PBS_O_WORKDIR"
source /home/suzunyan/.venv/bin/activate
export OMP_NUM_THREADS=1

python muonNN.py \
  --n-events 0 \
  --d0-mode both \
  --neighbor-dr-cut 0.5 \
  --neighbor-dz-cut 10 \
  --max-neighbors 10 \
  --use-gbreweighter true \
  --epochs 21 \
  --batch-size 512 \
  --learning-rate 0.001 \
  --hidden1 15 \
  --hidden2 15

echo "done"
