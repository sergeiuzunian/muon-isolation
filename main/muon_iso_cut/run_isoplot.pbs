#!/bin/bash
#PBS -N iso_plot
#PBS -l select=1:ncpus=1:mem=64gb
#PBS -l walltime=06:00:00
#PBS -q rqdf
#PBS -o /home/suzunyan/projects/muonisolation/job_logs/
#PBS -e /home/suzunyan/projects/muonisolation/job_logs/
#PBS -m ae

#isoPLOT.py cone scan: dR 0.2 to 0.5 with no dz cut, the auto table, and fixed 10 to 30 mm

cd "$PBS_O_WORKDIR"
source /home/suzunyan/.venv/bin/activate

for dr in 0.2 0.3 0.4 0.5; do
  for dz in none auto 10 15 20 25 30; do
    echo "===== iso dR=$dr dz=$dz ====="
    python isoPLOT.py --n-events 0 --iso-dr-cut "$dr" --iso-dz-cut "$dz"
  done
done

echo "done"
